<mxfile host="app.diagrams.net"><diagram name="User Flow"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="1. Login&lt;br&gt;Manager / Team Member" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="680" height="105" as="geometry"/></mxCell><mxCell id="3" value="2. Dashboard&lt;br&gt;View action items, status and summary" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="680" height="105" as="geometry"/></mxCell><mxCell id="4" value="3. View / Search / Filter&lt;br&gt;Action items by status, assignee, priority or due date" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="680" height="105" as="geometry"/></mxCell><mxCell id="5" value="4. Create / Assign Action&lt;br&gt;Manager creates an item and assigns a team member" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="680" height="105" as="geometry"/></mxCell><mxCell id="6" value="5. Update Action&lt;br&gt;Edit permitted fields and update status" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="800" width="680" height="105" as="geometry"/></mxCell><mxCell id="7" value="6. Add Comment&lt;br&gt;Discuss progress or blockers" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="960" width="680" height="105" as="geometry"/></mxCell><mxCell id="8" value="7. Complete / Reopen&lt;br&gt;Complete the action or reopen when permitted" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="1120" width="680" height="105" as="geometry"/></mxCell><mxCell id="9" value="8. View History&lt;br&gt;Review status changes and activity" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="1280" width="680" height="105" as="geometry"/></mxCell><mxCell id="10" value="9. Logout" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="1440" width="680" height="105" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="2" target="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="3" target="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="4" target="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="5" target="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="6" target="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" edge="1" parent="1" source="7" target="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="8" target="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="9" target="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>